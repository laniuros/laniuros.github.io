---
interface Props {
  label: string;
  subtitle: string;
  variant?: "human" | "ai";
  src?: string;
}

const { label, subtitle, variant = "human", src } = Astro.props;
---

<figure class={`avatar-slot ${variant}`}>
  {
    src ? (
      <img class="avatar-image" src={src} alt={`${label} portrait`} width="132" height="132" loading="lazy" />
    ) : (
      <div class="avatar-pixels" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    )
  }
  <figcaption>
    <strong>{label}</strong>
    <small>{subtitle}</small>
  </figcaption>
</figure>
